# ===================================================
# ResQNow - MERN Stack Environment Variables Template
# ===================================================

# Backend Environment Variables
PORT=3000
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net/resqnow?retryWrites=true&w=majority"
JWT_SECRET="resqnow_super_secure_jwt_secret_change_in_production_2026"
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GOOGLE_MAPS_API_KEY="AIzaSyYourGoogleMapsApiKeyHere"

# Frontend Environment Variables (Client)
# In development within AI Studio or fullstack proxy, leave empty or set to /api
VITE_API_URL="/api"
